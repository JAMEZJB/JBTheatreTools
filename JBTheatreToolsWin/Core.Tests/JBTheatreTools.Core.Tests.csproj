<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for JBTheatreTools.Core — runnable on any OS: `dotnet test JBTheatreToolsWin/Core.Tests`.
       Fixtures/ holds the REAL signed manifest from the public JBTheatreTools v1.15.0 release. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>JBTheatreTools.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/JBTheatreTools.Core.csproj" />
    <Compile Include="../InstallManager.cs" Link="Integration/InstallManager.cs" />
    <Compile Include="../Catalog.cs" Link="Integration/Catalog.cs" />
    <Compile Include="../SelfReplace.cs" Link="Integration/SelfReplace.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
