<?xml version="1.0" encoding="utf-8"?>
<!-- Never back up or transfer the launcher's credential store (§5 rule 5). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="jbtt-secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jbtt-secrets.xml" />
    </device-transfer>
</data-extraction-rules>
